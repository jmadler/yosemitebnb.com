---
import Layout from '../layouts/Layout.astro';
import { siteInfo } from '../data/siteInfo';
import { roomsArray } from '../data/roomsArray';
import { activities, currentSeason, seasonalActivities } from '../data/activities';
import TestimonialSlider from '../components/Testimonials/TestimonialSlider.astro';

const meta = {
	title: "The Getaway Yosemite BnB - Your Cozy Mountain Retreat",
	description: "Experience comfort and convenience near Yosemite National Park. The Getaway BnB offers cozy rooms, breathtaking views, and easy access to all Yosemite has to offer.",
	keywords: "Yosemite lodging, Yosemite BnB, Midpines hotel, Highway 140 accommodation, mountain retreat, Yosemite accommodation",
	image: "/images/lodge/exterior.jpg",
	url: "https://www.thegatewayyosemite.com",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "LodgingBusiness",
		"name": "The Getaway Yosemite",
		"image": "/images/lodge/exterior.jpg",
		"description": "Cozy mountain lodging near Yosemite National Park",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "6484A CA-140",
			"addressLocality": "Midpines",
			"addressRegion": "CA",
			"postalCode": "95345",
			"addressCountry": "US"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": 37.5655556,
			"longitude": -119.9394444
		},
		"telephone": "(209) 742-4019",
		"priceRange": "$$",
		"amenityFeature": [
			{ "@type": "LocationFeatureSpecification", "name": "Mountain view" },
			{ "@type": "LocationFeatureSpecification", "name": "Free parking" },
			{ "@type": "LocationFeatureSpecification", "name": "Wifi" }
		]
	}
};

// Get the current season's activities info
const seasonInfo = seasonalActivities[currentSeason];
---

<Layout title={meta.title} meta={meta}>
	<nav class="page-nav">
		<button class="mobile-menu-btn" aria-label="Toggle menu">
			<span class="menu-icon"></span>
		</button>
		<ul class="nav-links">
			<li><a href="#rooms">Our Rooms</a></li>
			<li><a href="#testimonials">Testimonials</a></li>
			<li><a href="#location">Location & Contact</a></li>
			<li><a href="#park-info">Yosemite Info</a></li>
			<li><a href="#activities">Seasonal Activities</a></li>
		</ul>
	</nav>

	<main class="container">
		<section class="hero">
			<div class="hero-carousel">
				<img src="/images/lodge/exterior.jpg" alt="Lodge exterior" class="active" />
				<img src="/images/lodge/lobby.jpg" alt="Lodge lobby" />
				<img src="/images/lodge/garden.jpg" alt="Lodge garden" />
				<img src="/images/lodge/view.jpg" alt="Mountain view" />
			</div>
			<div class="hero-content">
				<h1>Welcome to The Getaway Yosemite BnB</h1>
				<p>Your cozy mountain retreat near Yosemite National Park</p>
				<div class="hero-cta">
					<a href="#rooms" class="cta-button">View Rooms</a>
					<a href="tel:2097424019" class="cta-button secondary">Call Us</a>
				</div>
			</div>
			<div class="scroll-indicator">
				<span>Scroll to explore</span>
				<div class="chevron"></div>
			</div>
		</section>

		<section class="park-notice">
			<div class="notice-content">
				<h2>Important Yosemite National Park Information</h2>
				<div class="notice-grid">
					<div class="notice-card">
						<h3>Park Information</h3>
						<div class="external-links">
							<a href="https://www.nps.gov/yose/planyourvisit/conditions.htm" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🌲</span>
								<span class="external-link-text">Current Conditions</span>
							</a>
							<a href="https://www.nps.gov/yose/planyourvisit/reservations.htm" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🎫</span>
								<span class="external-link-text">Reservations</span>
							</a>
							<a href="https://www.nps.gov/yose/planyourvisit/hiking.htm" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🥾</span>
								<span class="external-link-text">Hiking Trails</span>
							</a>
							<a href="https://www.nps.gov/yose/planyourvisit/weather.htm" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🌤️</span>
								<span class="external-link-text">Weather Info</span>
							</a>
						</div>
					</div>

					<div class="notice-card">
						<h3>Location & Directions</h3>
						<div class="map-embed">
							<iframe 
								width="100%" 
								height="200" 
								style="border:0;" 
								loading="lazy" 
								allowfullscreen
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2359.825042541392!2d-119.9278703875729!3d37.55537857062617!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8096b8f5a2d3aad3%3A0x2f2014a61205154!2sThe%20Getaway!5e1!3m2!1sen!2sus!4v1740016303879!5m2!1sen!2sus"
							></iframe>
						</div>
						<div class="map-links">
							<a href="https://maps.google.com/?q=The+Getaway+Yosemite+BnB+6484A+CA-140+Midpines+CA+95345" 
							   class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">📍</span>
								<span class="external-link-text">Open in Google Maps</span>
							</a>
							<a href="http://maps.apple.com/?q=The+Getaway+Yosemite+BnB+6484A+CA-140+Midpines+CA+95345" 
							   class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">📍</span>
								<span class="external-link-text">Open in Apple Maps</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="content-wrapper">
			<section id="rooms" class="rooms">
				<h2>Our Rooms</h2>
				<div class="rooms-grid">
					{roomsArray.map(room => (
						<a href={`/rooms/${room.id}`} class="room-card">
							<img src={room.images[0]} alt={room.label} />
							<div class="room-info">
								<h2>{room.label}</h2>
								<p class="rating">★{room.rating}</p>
								<p class="capacity">{room.capacity}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<section id="testimonials" class="testimonials">
				<h2>Guest Testimonials</h2>
				
				<TestimonialSlider />

				<div class="trust-badges">
					<div class="badge">
						<span class="large">4.8</span>
						<span>Average Rating</span>
					</div>
					<div class="badge">
						<span class="large">1000+</span>
						<span>Happy Guests</span>
					</div>
					<div class="badge">
						<span class="large">45 min</span>
						<span>to Yosemite Valley</span>
					</div>
				</div>
			</section>

			<section id="location" class="location">
				<h2>Location & Contact</h2>
				<div class="info-grid">
					<div class="contact-info">
						<h3>Contact & Check-in</h3>
						<p>
							<strong>Phone:</strong><br />
							<a href="tel:2097424019">(209) 742-4019</a>
						</p>
						<p>
							<strong>Email:</strong><br />
							<a href="mailto:rlntlss1@gmail.com">rlntlss1@gmail.com</a>
						</p>
						<p>
							<strong>Check-in:</strong> {siteInfo.checkIn}<br />
							<strong>Check-out:</strong> {siteInfo.checkOut}
						</p>
						<p>
							<strong>Parking:</strong><br />
							{siteInfo.parking}
						</p>
					</div>

					<div class="distances">
						<h3>Travel Times</h3>
						<ul>
							{Object.entries(siteInfo.distances).map(([place, time]) => (
								<li>
									<strong>{place}:</strong> {time}
								</li>
							))}
						</ul>
					</div>

					<div class="area-info">
						<h3>Area Information</h3>
						<div class="external-links">
							{siteInfo.nearbyAttractions.map(attraction => (
								<a href={attraction.url} class="external-link" target="_blank" rel="noopener noreferrer">
									<span class="external-link-icon">🏔️</span>
									<span class="external-link-text">{attraction.name}</span>
								</a>
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="amenities" class="amenities">
				<h2>Amenities & Features</h2>
				<div class="amenities-grid">
					<div class="amenity-category">
						<h3>Room Features</h3>
						<div class="external-links">
							<div class="external-link">
								<span class="external-link-icon">🛏️</span>
								<span class="external-link-text">Comfortable Queen Beds</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">📺</span>
								<span class="external-link-text">Smart TV with Streaming</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">❄️</span>
								<span class="external-link-text">Air Conditioning</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🔒</span>
								<span class="external-link-text">Private Entrance</span>
							</div>
						</div>
					</div>

					<div class="amenity-category">
						<h3>Kitchen & Dining</h3>
						<div class="external-links">
							<div class="external-link">
								<span class="external-link-icon">🍳</span>
								<span class="external-link-text">Full Kitchen</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">☕</span>
								<span class="external-link-text">Coffee Maker</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🍽️</span>
								<span class="external-link-text">Dining Area</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🧊</span>
								<span class="external-link-text">Refrigerator</span>
							</div>
						</div>
					</div>

					<div class="amenity-category">
						<h3>Connectivity</h3>
						<div class="external-links">
							<div class="external-link">
								<span class="external-link-icon">📶</span>
								<span class="external-link-text">Fast WiFi</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">💻</span>
								<span class="external-link-text">Work Space</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">📱</span>
								<span class="external-link-text">Cell Service</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🔌</span>
								<span class="external-link-text">USB Charging</span>
							</div>
						</div>
					</div>

					<div class="amenity-category">
						<h3>Property Features</h3>
						<div class="external-links">
							<div class="external-link">
								<span class="external-link-icon">🅿️</span>
								<span class="external-link-text">Free Parking</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🌄</span>
								<span class="external-link-text">Mountain Views</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🧺</span>
								<span class="external-link-text">Laundry Facilities</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">♨️</span>
								<span class="external-link-text">Shared Hot Tub</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="park-info" class="park-info">
				<h2>Yosemite National Park Information</h2>
				<div class="external-links">
					<a href="https://www.nps.gov/yose/planyourvisit/reservations.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🎫</span>
						<span class="external-link-text">Entrance Reservations</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/fees.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">💰</span>
						<span class="external-link-text">Park Fees & Passes</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/conditions.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🌲</span>
						<span class="external-link-text">Current Conditions</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/maps.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🗺️</span>
						<span class="external-link-text">Park Maps</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/hiking.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🥾</span>
						<span class="external-link-text">Hiking Trails</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/climbing.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🧗‍♂️</span>
						<span class="external-link-text">Rock Climbing</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/weather.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🌤️</span>
						<span class="external-link-text">Weather & Seasons</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/fishing.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🎣</span>
						<span class="external-link-text">Fishing Information</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/bears.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">🐻</span>
						<span class="external-link-text">Bear Safety</span>
					</a>
					<a href="https://www.nps.gov/yose/planyourvisit/yoursafety.htm" class="external-link" target="_blank" rel="noopener noreferrer">
						<span class="external-link-icon">⚠️</span>
						<span class="external-link-text">Safety Guidelines</span>
					</a>
				</div>
			</section>

			<section id="activities" class="activities">
				<h2>Activities by Season</h2>
				<div class="activities-grid">
					{Object.entries(seasonalActivities).map(([season, info]) => (
						<div class={`activity-box ${season === currentSeason ? 'current' : ''}`}>
							<div class="activity-carousel">
								<div class="carousel-images">
									<img src={info.image} alt={`${season} activities`} class="active" />
									{info.additionalImages?.map((img: string) => (
										<img src={img} alt={`${season} activities`} loading="lazy" />
									))}
								</div>
								<button class="carousel-prev" aria-label="Previous image">←</button>
								<button class="carousel-next" aria-label="Next image">→</button>
							</div>
							<div class="activity-content">
								<h3>{season.charAt(0).toUpperCase() + season.slice(1)}</h3>
								<p class="temp">{info.temp}</p>
								<p class="highlight">{info.highlights}</p>
								<ul class="activity-list">
									{info.activities.map((activity: string) => (
										<li>{activity}</li>
									))}
								</ul>
							</div>
							
							{/* Display detailed activities for this season */}
							<div class="detailed-activities">
								{info.detailedActivities.map((activity: { title: string; description: string }) => (
									<div class="detailed-activity">
										<h4>{activity.title}</h4>
										<p>{activity.description}</p>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="rules">
				<h2>House Rules & Information</h2>
				<div class="rules-grid">
					<div class="rules-list">
						<ul>
							{siteInfo.houseRules.map(rule => (
								<li>{rule}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section id="transportation" class="transportation">
				<h2>Getting Here & Around</h2>
				<div class="transport-grid">
					<div class="transport-option">
						<h3>YARTS Bus Service</h3>
						<p>{siteInfo.transportation["YARTS Bus"].description}</p>
						<div class="external-links">
							<div class="external-link">
								<span class="external-link-icon">🚌</span>
								<span class="external-link-text">YARTS Midpines Stop - 2 min walk</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">🏪</span>
								<span class="external-link-text">Midpines Store - 3 min walk</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">⛽</span>
								<span class="external-link-text">Gas Station - 3 min walk</span>
							</div>
							<div class="external-link">
								<span class="external-link-icon">📬</span>
								<span class="external-link-text">USPS Post Office - 3 min walk</span>
							</div>
							<a href={siteInfo.transportation["YARTS Bus"].url} class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🎫</span>
								<span class="external-link-text">View Schedule & Book Tickets</span>
							</a>
						</div>
						<p>Schedule: {siteInfo.transportation["YARTS Bus"].schedule}</p>
						<p>Cost: {siteInfo.transportation["YARTS Bus"].cost}</p>
					</div>

					<div class="transport-option">
						<h3>Car Services</h3>
						<div class="external-links">
							<a href="https://www.enterprise.com/en/car-rental-locations/us/ca/merced-3030.html" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🚗</span>
								<span class="external-link-text">Enterprise Rent-A-Car - Merced</span>
							</a>
							<a href="https://www.hertz.com/us/en/location/unitedstates/california/fresno" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🚙</span>
								<span class="external-link-text">Hertz - Fresno Airport</span>
							</a>
							<a href="https://www.yosemiteprivatetours.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🚐</span>
								<span class="external-link-text">Yosemite Private Tours</span>
							</a>
							<a href="https://discoveryosemite.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🚍</span>
								<span class="external-link-text">Discover Yosemite Tours</span>
							</a>
						</div>
					</div>

					<div class="transport-option">
						<h3>Coffee & Cafes</h3>
						<div class="external-links">
							<a href="https://www.mariposacoffeecompany.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">☕</span>
								<span class="external-link-text">Mariposa Coffee Company</span>
							</a>
							<a href="https://www.facebook.com/ponyexpressomariposa/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">☕</span>
								<span class="external-link-text">Pony Expresso Coffee House</span>
							</a>
						</div>
					</div>

					<div class="transport-option">
						<h3>Markets & Groceries</h3>
						<div class="external-links">
							<a href="https://www.highcountryhealthfoods.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🥪</span>
								<span class="external-link-text">High Country Health Foods</span>
							</a>
							<a href="https://www.pioneersupermarket.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🏪</span>
								<span class="external-link-text">Pioneer Market</span>
							</a>
						</div>
					</div>

					<div class="transport-option">
						<h3>Restaurants & Bars</h3>
						<div class="external-links">
							<a href="https://www.1850restaurant.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🍽️</span>
								<span class="external-link-text">1850 Restaurant & Brewery</span>
							</a>
							<a href="https://hideout-saloon.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🍺</span>
								<span class="external-link-text">The Hideout Saloon</span>
							</a>
							<a href="https://minersroadhouse140.com/roadhouse-bar" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🍺</span>
								<span class="external-link-text">Miner's Roadhouse</span>
							</a>
							<a href="https://www.thegrovehousemariposa.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🍺</span>
								<span class="external-link-text">The Grove House</span>
							</a>
							<a href="https://www.charlesstreetdinnerhouse.com/" class="external-link" target="_blank" rel="noopener noreferrer">
								<span class="external-link-icon">🍽️</span>
