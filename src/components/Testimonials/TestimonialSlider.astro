---
import Testimonial from './Testimonial.astro';
import { testimonials } from '../../data/testimonials';
---

<div class="testimonials-container">
  <div class="testimonial-slider">
    {testimonials.map(testimonial => (
      <Testimonial
        name={testimonial.name}
        location={testimonial.location}
        date={testimonial.date}
        text={testimonial.text}
        avatar={testimonial.avatar}
      />
    ))}
  </div>

  <div class="testimonial-controls">
    <button id="prev-testimonial" class="testimonial-control" aria-label="Previous testimonials">
      <span class="control-icon">◀</span>
    </button>
    <div class="testimonial-indicators">
      <!-- Will be filled by JavaScript -->
    </div>
    <button id="next-testimonial" class="testimonial-control" aria-label="Next testimonials">
      <span class="control-icon">▶</span>
    </button>
  </div>
</div>

<style>
  .testimonials-container {
    width: 100%;
  }

  .testimonial-slider {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .testimonial-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .testimonial-control {
    background: var(--accent);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
  }

  .testimonial-control:hover {
    transform: scale(1.1);
    background-color: var(--accent-dark);
  }

  .testimonial-indicators {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .testimonial-slider {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const testimonialCards = document.querySelectorAll<HTMLElement>('.testimonial-card');
    const prevButton = document.getElementById('prev-testimonial');
    const nextButton = document.getElementById('next-testimonial');
    const indicatorsContainer = document.querySelector<HTMLElement>('.testimonial-indicators');
    
    // Early exit if elements don't exist
    if (!prevButton || !nextButton || !indicatorsContainer) return;
    
    const cardsPerPage = window.innerWidth < 768 ? 1 : 3;
    const totalPages = Math.ceil(testimonialCards.length / cardsPerPage);
    let currentPage = 0;
    
    // Create indicator dots
    for (let i = 0; i < totalPages; i++) {
      const indicator = document.createElement('div');
      indicator.classList.add('testimonial-indicator');
      indicator.style.width = '10px';
      indicator.style.height = '10px';
      indicator.style.borderRadius = '50%';
      indicator.style.backgroundColor = i === 0 ? 'var(--accent)' : 'var(--border)';
      indicator.style.cursor = 'pointer';
      indicator.style.transition = 'background-color 0.2s';
      
      if (i === 0) indicator.classList.add('active');
      indicator.addEventListener('click', () => goToPage(i));
      indicatorsContainer.appendChild(indicator);
    }
    
    // Show only first page initially
    updateVisibleCards();
    
    // Event listeners for navigation buttons
    prevButton.addEventListener('click', () => {
      if (currentPage > 0) {
        currentPage--;
        updateVisibleCards();
        updateIndicators();
      }
    });
    
    nextButton.addEventListener('click', () => {
      if (currentPage < totalPages - 1) {
        currentPage++;
        updateVisibleCards();
        updateIndicators();
      }
    });
    
    // Function to update visible cards
    function updateVisibleCards() {
      testimonialCards.forEach((card, index) => {
        const startIndex = currentPage * cardsPerPage;
        const endIndex = startIndex + cardsPerPage;
        
        if (index >= startIndex && index < endIndex) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
    
    // Function to update indicator dots
    function updateIndicators() {
      const indicators = document.querySelectorAll<HTMLElement>('.testimonial-indicator');
      indicators.forEach((indicator, index) => {
        if (index === currentPage) {
          indicator.classList.add('active');
          indicator.style.backgroundColor = 'var(--accent)';
        } else {
          indicator.classList.remove('active');
          indicator.style.backgroundColor = 'var(--border)';
        }
      });
    }
    
    // Function to go to a specific page
    function goToPage(page: number) {
      currentPage = page;
      updateVisibleCards();
      updateIndicators();
    }
    
    // Handle window resize
    window.addEventListener('resize', () => {
      const newCardsPerPage = window.innerWidth < 768 ? 1 : 3;
      const newTotalPages = Math.ceil(testimonialCards.length / newCardsPerPage);
      
      if (newTotalPages !== totalPages) {
        // Reset indicators
        if (indicatorsContainer) {
          indicatorsContainer.innerHTML = '';
          for (let i = 0; i < newTotalPages; i++) {
            const indicator = document.createElement('div');
            indicator.classList.add('testimonial-indicator');
            indicator.style.width = '10px';
            indicator.style.height = '10px';
            indicator.style.borderRadius = '50%';
            indicator.style.backgroundColor = i === 0 ? 'var(--accent)' : 'var(--border)';
            indicator.style.cursor = 'pointer';
            indicator.style.transition = 'background-color 0.2s';
            
            if (i === 0) indicator.classList.add('active');
            indicator.addEventListener('click', () => goToPage(i));
            indicatorsContainer.appendChild(indicator);
          }
        }
        
        // Reset current page
        currentPage = 0;
        updateVisibleCards();
        updateIndicators();
      }
    });
  });
</script> 